# Database Configuration
DATABASE_URL="postgres://your_db_user:your_db_password@your_db_host:your_db_port/your_db_name"

# Example for local development with a Dockerized Postgres:
# DATABASE_URL="postgres://logistics_user:logistics_password@localhost:5432/logistics_db"

# Application settings (can be added as needed)
# PROJECT_NAME="Logistics Dashboard API"
# API_V1_STR="/api/v1"

# JWT Authentication
SECRET_KEY="your_super_secret_random_key_here" # IMPORTANT: Generate a strong random key for production
ACCESS_TOKEN_EXPIRE_MINUTES=30 # Lifetime of access tokens in minutes
